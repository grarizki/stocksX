# Local development bindings for `wrangler dev` (gitignored; copy to .dev.vars).
# PASSWORD_PEPPER must be at least 32 characters. Production uses a real
# Worker secret with a different value: `wrangler secret put PASSWORD_PEPPER`.
# PASSWORD_PEPPER=local-development-pepper-value-000000000000
# TRUSTED_ORIGIN=http://localhost:8787

# Anthropic API Key (optional; AI features are not enabled without it)
# ANTHROPIC_API_KEY=your_anthropic_api_key